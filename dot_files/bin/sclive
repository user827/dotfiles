#!/bin/sh
set -eu

. ~/.config/screencap.conf

if [ "$1" = replay ]; then
  shift
  exec gpu-screen-recorder -w "$1" -c mkv -f 60 -a default_output -q ultra -ab 160kbps -r 1800 -k hevc -restart-replay-on-save yes -o ~/Videos/replays
else
  exec gpu-screen-recorder -w "$1" -f 60 -a default_output -k hevc -q ultra -ab 160kbps -o ~/Videos/"video_$(date +"%F %T")".mkv
fi
